---
layout: default
---
<% event = data.event %>
<article class="bg-white">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">

    <nav aria-label="Migas de pan" class="text-sm">
      <ol class="flex items-center gap-2 text-skin-dimmed">
        <li><a href="/" class="hover:text-sky-600">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/eventos/" class="font-bold uppercase text-sky-600 hover:text-sky-700">Eventos pasados</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page"><%= event.presenter %></li>
      </ol>
    </nav>

    <header class="mt-8 grid grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2">
      <div>
        <p class="text-xl uppercase text-skin-dimmed">Sesión de f/64</p>
        <h1 class="font-oswald text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
          <span class="block"><%= event.presenter %></span>
          <span class="mt-2 block text-xl font-normal tracking-normal text-skin-muted sm:text-2xl">Plática fotográfica en f/64, Colima</span>
        </h1>
      </div>
      <div class="sm:text-right">
        <p class="font-oswald text-2xl font-bold tracking-tight sm:text-3xl">
          <% if data.iso_date %>
            <time datetime="<%= data.iso_date %>"><%= event.date %></time>
          <% else %>
            <%= event.date %>
          <% end %>
        </p>
        <p class="mt-2 text-skin-muted"><%= event.address %></p>
      </div>
    </header>

    <p class="mt-8 max-w-3xl text-xl text-skin-muted"><%= event.tagline %></p>

    <% if data.links.any? %>
      <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
        <% data.links.each do |link| %>
          <li>
            <a href="<%= link.url %>" rel="noopener" target="_blank"
               class="text-sm font-bold uppercase text-sky-600 hover:text-sky-700"><%= link.title %></a>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if data.photos.any? %>
      <section class="mt-16">
        <h2 class="font-oswald text-2xl font-bold tracking-tight sm:text-3xl">El trabajo de <%= event.presenter %></h2>
        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
          <% data.photos.each_with_index do |photo, index| %>
            <figure class="<%= index.zero? ? "col-span-1 sm:col-span-2" : "col-span-1" %>">
              <%# The first photo is the largest on the page and the likeliest LCP
                  element, so it loads eagerly while the rest stay lazy. %>
              <%= render "picture",
                    src: photo,
                    alt: "Fotografía #{index + 1} de #{event.presenter}, presentada en su plática de f/64 en Colima",
                    classes: "w-full rounded-xs shadow-xs",
                    eager: index.zero? %>
              <figcaption class="mt-3 text-sm font-bold">&copy; <%= event.copyright %></figcaption>
            </figure>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if data.event_photos.any? %>
      <section class="mt-16">
        <h2 class="font-oswald text-2xl font-bold tracking-tight sm:text-3xl">La sesión</h2>
        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
          <% data.event_photos.each_with_index do |photo, index| %>
            <figure>
              <%= render "picture",
                    src: photo,
                    alt: "Público en la sesión de f/64 con #{event.presenter}, #{event.date}",
                    classes: "w-full rounded-xs shadow-xs",
                    eager: false %>
              <figcaption class="mt-3 text-sm font-bold">&copy; f/64</figcaption>
            </figure>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if data.photos.empty? && data.event_photos.empty? %>
      <p class="mt-16 text-skin-dimmed">No hay fotografías disponibles de esta sesión.</p>
    <% end %>

    <nav aria-label="Otras sesiones" class="mt-20 grid grid-cols-1 gap-6 border-t border-gray-200 pt-8 sm:grid-cols-2">
      <div>
        <% if data.older_event %>
          <p class="text-sm uppercase text-skin-dimmed">Sesión anterior</p>
          <a href="<%= event_path(data.older_event) %>" class="font-oswald text-xl font-bold hover:text-sky-600">
            <%= data.older_event.presenter %>
          </a>
          <p class="text-sm text-skin-dimmed"><%= data.older_event.date %></p>
        <% end %>
      </div>
      <div class="sm:text-right">
        <% if data.newer_event %>
          <p class="text-sm uppercase text-skin-dimmed">Sesión siguiente</p>
          <a href="<%= event_path(data.newer_event) %>" class="font-oswald text-xl font-bold hover:text-sky-600">
            <%= data.newer_event.presenter %>
          </a>
          <p class="text-sm text-skin-dimmed"><%= data.newer_event.date %></p>
        <% end %>
      </div>
    </nav>
  </div>
</article>
